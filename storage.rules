rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Same check as firestore.rules' isAdmin(), read across from Firestore.
    function isAdmin() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Owner uploads: image files under 5 MB. The app resizes every photo in
    // the browser first (src/lib/images.js), so real uploads are a few
    // hundred KB — the cap only stops uploads that skip the app.
    function validImageUpload() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Provider listing photos live at listings/{providerId}/{filename}.
    // Anyone can read (public marketplace). Only the owning provider can
    // upload to their own folder; they or an admin (moderation) can delete.
    match /listings/{providerId}/{allPaths=**} {
      allow read:   if true;
      allow write:  if request.auth != null
                    && request.auth.uid == providerId
                    && validImageUpload();
      allow delete: if (request.auth != null && request.auth.uid == providerId)
                    || isAdmin();
    }

    // Profile pictures live at avatars/{userId}/{filename}. Publicly readable
    // (shown on public listings/reviews); only the account owner can upload
    // to their own folder; they or an admin (moderation) can delete.
    match /avatars/{userId}/{allPaths=**} {
      allow read:   if true;
      allow write:  if request.auth != null
                    && request.auth.uid == userId
                    && validImageUpload();
      allow delete: if (request.auth != null && request.auth.uid == userId)
                    || isAdmin();
    }

    // Deny every other path by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
