# Copy to .env (and .env.<firebase-project-id> for project-specific
# overrides) — see https://firebase.google.com/docs/functions/config-env.
# Never commit the real file; only .env.example is tracked.

# --- PayPal ---
# From a PayPal developer app (https://developer.paypal.com/dashboard/applications).
# Use the sandbox app's credentials until you're ready to go live.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# From the webhook you register in that same dashboard, subscribed to at
# least PAYMENT.CAPTURE.COMPLETED and PAYMENT.CAPTURE.DENIED, pointed at
# https://<region>-<project-id>.cloudfunctions.net/paypalWebhook
PAYPAL_WEBHOOK_ID=
# https://api-m.sandbox.paypal.com while testing, https://api-m.paypal.com once live.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# --- App ---
# The deployed frontend's own origin — where a consumer lands after a
# redirect-based payment resolves (see functions/http.js).
APP_BASE_URL=https://surama-app.web.app

# --- MMG (Mobile Money Guyana) ---
# Issued by MMG Merchant Services as a credential package after signing
# up at mmg.gy/business — ask for the Sandbox/UAT package first. Field
# names here match the reference flow documented at
# github.com/Revamped-GY/MMG-Checkout-Woocommerce-Guyana; verify them
# against what MMG actually issues before relying on this for real money.
#
# One-time manual step with MMG Merchant Services (not set by this app):
# register https://<region>-<project-id>.cloudfunctions.net/mmgReturn as
# this merchant's "Response URL" / callback URL.
MMG_MODE=sandbox

MMG_SANDBOX_CHECKOUT_URL=https://mmgpg.mmgtest.net/mmg-pg/web/payments
MMG_SANDBOX_MERCHANT_ID=
MMG_SANDBOX_CLIENT_ID=
MMG_SANDBOX_MERCHANT_NAME=
MMG_SANDBOX_SECRET_KEY=
# PEM, one line with literal \n for line breaks (e.g. "-----BEGIN
# PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----").
MMG_SANDBOX_PUBLIC_KEY=
MMG_SANDBOX_PRIVATE_KEY=
# Base for the optional Merchant Initiated API's Transaction Lookup call,
# used as a best-effort corroboration of a checkout result.
MMG_SANDBOX_API_BASE=
MMG_SANDBOX_WSS_MID=
MMG_SANDBOX_WSS_MKEY=
MMG_SANDBOX_WSS_MSECRET=
MMG_SANDBOX_API_KEY=

# Same fields again, live credentials, once sandbox testing is done.
MMG_LIVE_CHECKOUT_URL=https://mmgpg.mymmg.gy/mmg-pg/web/payments
MMG_LIVE_MERCHANT_ID=
MMG_LIVE_CLIENT_ID=
MMG_LIVE_MERCHANT_NAME=
MMG_LIVE_SECRET_KEY=
MMG_LIVE_PUBLIC_KEY=
MMG_LIVE_PRIVATE_KEY=
MMG_LIVE_API_BASE=
MMG_LIVE_WSS_MID=
MMG_LIVE_WSS_MKEY=
MMG_LIVE_WSS_MSECRET=
MMG_LIVE_API_KEY=
