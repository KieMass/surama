rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Shared by any collection that needs to grant admins elevated access.
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // The payment side of a request (set only by Cloud Functions via the
    // Admin SDK, which bypasses these rules entirely) must never be
    // forgeable through an otherwise-legitimate client update to the
    // request doc — e.g. a consumer cancelling shouldn't be able to also
    // sneak in paymentStatus: 'paid' on the same write.
    function paymentFieldsUntouched(before, after) {
      return !("paymentStatus"  in after.diff(before).affectedKeys())
          && !("depositAmount"  in after.diff(before).affectedKeys())
          && !("balanceAmount"  in after.diff(before).affectedKeys())
          && !("depositPercent" in after.diff(before).affectedKeys())
          && !("commissionPercent" in after.diff(before).affectedKeys());
    }

    // Same fields, checked at create time: otherwise a consumer could
    // create a request that already says paymentStatus: 'paid', or lock in
    // a 0% commission / 0 deposit before the first payment ever starts.
    function noPaymentFields(data) {
      return !data.keys().hasAny(['paymentStatus', 'depositAmount', 'balanceAmount', 'depositPercent', 'commissionPercent']);
    }

    // ── Users ──────────────────────────────────────────────────────────────
    // Any authenticated user can read any profile (marketplace providers are
    // publicly discoverable). The account owner can create their own doc at
    // registration and edit their own profile fields — but NOT the
    // moderation fields (role/disabled/verified), which are admin-only
    // below. Without that split, any signed-in user could self-promote to
    // admin with a raw updateDoc() call, bypassing the admin UI entirely.
    match /users/{userId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.role in ['consumer', 'provider']
                    && !('disabled' in request.resource.data)
                    && !('verified' in request.resource.data);

      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['role', 'disabled', 'verified']);

      // Admins can disable/re-enable accounts, change roles, and toggle a
      // provider's verified badge from the admin pages, but can't otherwise
      // edit someone else's profile, and can't create or delete user docs
      // directly (those stay tied to Firebase Auth account creation/deletion).
      // They can also take down an inappropriate profile photo (photoURL
      // may only be cleared, never set to something else).
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['disabled', 'role', 'verified', 'photoURL'])
                    && (!('photoURL' in request.resource.data.diff(resource.data).affectedKeys())
                        || request.resource.data.photoURL == null);
    }

    // ── Public profiles ────────────────────────────────────────────────────
    // profiles/{uid}: just the name and photo shown next to someone's
    // listings, reviews and messages — public, unlike users/{uid}, so
    // signed-out visitors see them too. The owner keeps it in step with
    // their user doc (see src/lib/profiles.js). The photo must be one of
    // their own uploads in this project's Storage avatars folder, so a
    // profile can't hotlink an arbitrary outside image that admins can't
    // moderate. (The 127.0.0.1:9199 form is the local Storage emulator.)
    function validProfile(uid, d) {
      return d.keys().hasOnly(['name', 'photoURL'])
        && d.keys().hasAll(['name', 'photoURL'])
        && d.name is string && d.name.size() <= 100
        && (d.photoURL == null
            || (d.photoURL is string
                && d.photoURL.matches('(https://firebasestorage[.]googleapis[.]com|http://127[.]0[.]0[.]1:9199)/v0/b/[^/]+/o/avatars%2F' + uid + '%2F.*')));
    }

    match /profiles/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && validProfile(userId, request.resource.data);
      // Admins can only clear the photo (moderation), nothing else.
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoURL'])
                    && request.resource.data.photoURL == null;
    }

    // ── Services ───────────────────────────────────────────────────────────
    // A listing's photos: images is the gallery (up to 6, in display order)
    // and imageUrl its cover — always images[0], kept as its own field so
    // listing cards (and listings saved before galleries existed) only need
    // the one URL.
    function validListingImages(d) {
      return (!('images' in d) || (d.images is list && d.images.size() <= 6))
        && (!('imageUrl' in d) || d.imageUrl == null || d.imageUrl is string);
    }

    // Anyone (including unauthenticated visitors) can read active listings.
    // Only authenticated providers (role verified via user doc) can create
    // or modify their own listings.
    match /services/{serviceId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.providerId == request.auth.uid
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'provider'
                    && request.resource.data.price is number
                    && request.resource.data.price >= 0
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 200
                    && request.resource.data.description is string
                    && request.resource.data.description.size() <= 2000
                    && validListingImages(request.resource.data);
      // Same field validation as create — an owner edit shouldn't be able to
      // set a negative price or an oversized title/description that create
      // already blocks.
      allow update: if request.auth != null
                    && resource.data.providerId == request.auth.uid
                    && request.resource.data.price is number
                    && request.resource.data.price >= 0
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 200
                    && request.resource.data.description is string
                    && request.resource.data.description.size() <= 2000
                    && validListingImages(request.resource.data);
      allow delete: if request.auth != null
                    && resource.data.providerId == request.auth.uid;

      // Admins can take a listing down (or restore it) and correct the
      // rating aggregate when they delete a review, but can't touch
      // anything else about someone else's listing.
      // They can also remove an inappropriate photo, which rewrites the
      // gallery (images) and its cover (imageUrl).
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'ratingSum', 'ratingCount', 'images', 'imageUrl'])
                    && validListingImages(request.resource.data);
    }

    // ── Requests ───────────────────────────────────────────────────────────
    // Consumers can create a request for themselves and read their own.
    // Providers can read and update (but not create) requests where they are
    // the named provider. Consumers may also update for a limited set of
    // status transitions (cancel, confirm completion, dispute completion).
    match /requests/{requestId} {
      allow create: if request.auth != null
                    && request.resource.data.consumerId == request.auth.uid
                    && request.resource.data.providerId != request.auth.uid
                    && noPaymentFields(request.resource.data)
                    && (request.resource.data.price == null
                        || (request.resource.data.price is number
                            && request.resource.data.price >= 0))
                    && (!('message' in request.resource.data)
                        || request.resource.data.message.size() <= 1000);

      allow read: if request.auth != null
                  && (resource.data.consumerId == request.auth.uid
                      || resource.data.providerId == request.auth.uid
                      || isAdmin());

      // Providers can update any field except the four immutable identity
      // fields and the payment fields (Cloud-Function-only, see above). If
      // they touch status, it must be one they're actually allowed to set
      // (matches the transitions requests.js performs on their behalf —
      // accept/decline, counter-propose, mark complete). If they touch
      // price/proposedPrice, it must stay a valid amount, same as the
      // create-time check.
      allow update: if request.auth != null
                    && resource.data.providerId == request.auth.uid
                    && !("consumerId"    in request.resource.data.diff(resource.data).affectedKeys())
                    && !("providerId"    in request.resource.data.diff(resource.data).affectedKeys())
                    && !("serviceId"     in request.resource.data.diff(resource.data).affectedKeys())
                    && !("consumerEmail" in request.resource.data.diff(resource.data).affectedKeys())
                    && paymentFieldsUntouched(resource.data, request.resource.data)
                    && (!("status" in request.resource.data.diff(resource.data).affectedKeys())
                        || request.resource.data.status in
                             ['accepted', 'declined', 'price_proposed', 'pending_completion'])
                    && (!("price" in request.resource.data)
                        || (request.resource.data.price is number && request.resource.data.price >= 0))
                    && (!("proposedPrice" in request.resource.data)
                        || (request.resource.data.proposedPrice is number && request.resource.data.proposedPrice >= 0));

      // Consumers may only change status (and add timestamp/price fields). Identity
      // fields must stay the same. Allowed transitions:
      //   pending | accepted        → cancelled
      //   pending_completion        → completed (confirm) or disputed (dispute)
      //   price_proposed            → accepted (accept price), price_proposed (counter),
      //                               or cancelled
      allow update: if request.auth != null
                    && resource.data.consumerId == request.auth.uid
                    && request.resource.data.consumerId    == resource.data.consumerId
                    && request.resource.data.providerId    == resource.data.providerId
                    && request.resource.data.serviceId     == resource.data.serviceId
                    && request.resource.data.consumerEmail == resource.data.consumerEmail
                    && paymentFieldsUntouched(resource.data, request.resource.data)
                    && (
                         (resource.data.status in ['pending', 'accepted']
                           && request.resource.data.status == 'cancelled')
                      || (resource.data.status == 'pending_completion'
                           && request.resource.data.status in ['completed', 'disputed'])
                      || (resource.data.status == 'price_proposed'
                           && request.resource.data.status in ['accepted', 'price_proposed', 'cancelled'])
                    );

      allow delete: if false;
    }

    // ── Payments ───────────────────────────────────────────────────────────
    // One doc per payment attempt (a request's deposit or balance leg).
    // Written only by Cloud Functions via the Admin SDK — a client never
    // creates, updates, or deletes one directly, only reads its own.
    match /payments/{paymentId} {
      allow read: if request.auth != null
                  && (resource.data.consumerId == request.auth.uid
                      || resource.data.providerId == request.auth.uid
                      || isAdmin());
      allow write: if false;
    }

    // ── Settings ───────────────────────────────────────────────────────────
    // Platform-wide config (e.g. settings/payments: commission/deposit
    // rates and the GYD/USD rate). Cloud Functions read these via the Admin
    // SDK regardless of this rule; this governs the admin settings page.
    // settings/payments is shape- and range-checked because a bad value
    // there (a 0 FX rate, a 100% deposit) would break every new payment.
    // It can't be deleted — the page always writes the full document.
    function validPaymentSettings(d) {
      return d.keys().hasOnly(['depositPercent', 'commissionPercent', 'gydUsdRate', 'updatedAt', 'updatedBy'])
        && d.keys().hasAll(['depositPercent', 'commissionPercent', 'gydUsdRate', 'updatedAt', 'updatedBy'])
        && d.depositPercent is number && d.depositPercent >= 1 && d.depositPercent <= 99
        && d.commissionPercent is number && d.commissionPercent >= 0 && d.commissionPercent <= 50
        && d.gydUsdRate is number && d.gydUsdRate > 0
        && d.updatedBy == request.auth.uid
        && d.updatedAt == request.time;
    }

    match /settings/{settingId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
                            && (settingId != 'payments' || validPaymentSettings(request.resource.data));
      allow delete: if isAdmin() && settingId != 'payments';
    }

    // ── Reviews ────────────────────────────────────────────────────────────
    // Anyone can read reviews (shown publicly on service detail pages).
    // Only authenticated consumers can create a review for themselves.
    // The original reviewer may update only rating and comment (not core
    // identity fields). Deletes are not allowed.
    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if request.auth != null
                    && request.resource.data.consumerId == request.auth.uid
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;

      allow update: if request.auth != null
                    && resource.data.consumerId == request.auth.uid
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.serviceId  == resource.data.serviceId
                    && request.resource.data.providerId == resource.data.providerId
                    && request.resource.data.requestId  == resource.data.requestId
                    && request.resource.data.consumerId == resource.data.consumerId;

      // Admins can remove an abusive or fake review; nobody else can delete one.
      allow delete: if isAdmin();
    }

    // ── Conversations & Messages ────────────────────────────────────────────
    // Only the two participants can read or write the conversation document.
    // Messages inherit access via a get() check on the parent conversation.
    match /conversations/{conversationId} {
      // Single-doc get: allow when doc doesn't exist yet (resource == null) so
      // getOrCreateConversation can check existence before writing. Participants
      // are enforced on list queries and on the create rule below.
      allow get: if request.auth != null
                 && (resource == null || request.auth.uid in resource.data.participants);
      allow list: if request.auth != null
                  && request.auth.uid in resource.data.participants;
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
                    && request.auth.uid in
                       get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if request.auth != null
                      && request.auth.uid in
                         get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
                      && (!('text' in request.resource.data)
                          || request.resource.data.text.size() <= 4000);
        allow update, delete: if false;
      }
    }

  }
}
