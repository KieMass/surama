# Loaded by `npm run dev:emulator` (vite --mode emulator). Not secret —
# "demo-" project IDs are offline-only: the emulators never reach a real
# Firebase project, so these values are placeholders, safe to commit.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-surama.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-surama
VITE_FIREBASE_STORAGE_BUCKET=demo-surama.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=demo-app-id
